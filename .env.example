# Copy this file to .env and fill in the values. Lines starting with # are ignored.
# Only the token and ORG are needed for a normal run.

# ---- Where your code lives -------------------------------------------------
# github (default), gitlab or bitbucket
PLATFORM=github

# GitHub organisation, GitLab group or Bitbucket workspace to profile.
ORG=your-org-name

# Read-only token for the platform above. Never commit this file.
#   GitHub:    fine-grained token, all repositories, read-only on Contents, Metadata, Pull requests
#   GitLab:    personal access token with read_api and read_repository
#   Bitbucket: app password with Repositories: Read and Pull requests: Read, plus your email below
GITHUB_TOKEN=
GITLAB_TOKEN=
BITBUCKET_TOKEN=
BITBUCKET_EMAIL=

# ---- Optional ---------------------------------------------------------------
# Profile only these repositories (comma separated, owner/name). Leave empty for the whole ORG.
REPOS=

# Profile a folder of repositories already cloned on this machine instead of using the API.
# Each sub folder with a .git directory is one repository. No token is needed in this mode.
LOCAL_DIR=

# Include archived repositories and forks (true or false).
INCLUDE_ARCHIVED=false
INCLUDE_FORKS=false

# How many repositories to process at the same time. 4 is safe on an 8 GB machine.
WORKERS=4

# Where the output zip is written. With Docker this must be a folder Docker shares (your home folder is shared by default).
OUTPUT_DIR=./output

# Name used in the zip file name (defaults to ORG).
LABEL=

# Cap on merged pull requests read per repository (empty = all). Use 1000 for a quick first run on large organisations.
MAX_PRS=

# Self hosted servers (leave empty for github.com / gitlab.com).
GITHUB_HOST=
GITLAB_HOST=

# Anything else to pass to the profiler, for example: --include-history-scan --report
EXTRA_ARGS=
